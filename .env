# Public site URL, used for Open Graph / Twitter preview images.
# Set this to your deployed address, e.g. https://your-name.vercel.app (no trailing slash).
VITE_SITE_URL=

# Form backend (optional). Paste a Formspree endpoint, e.g. https://formspree.io/f/xxxxxxxx
# Leave empty to use the built-in email-app fallback.
VITE_FORM_ENDPOINT=
